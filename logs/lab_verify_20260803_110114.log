 class QC_APA-CRITICAL_O
  priority level 1 
  shape average percent 7 
 ! 
 class QC_APA-HIGH_O
  bandwidth remaining percent 84 
 ! 
 class QC_APA-MEDIUM_O
  bandwidth remaining percent 5 
  random-detect default 
 ! 
 class class-default
  bandwidth remaining percent 1 
  random-detect default 
 ! 
 end-policy-map
