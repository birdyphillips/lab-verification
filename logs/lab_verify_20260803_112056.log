!
route-policy BP_MARKET-GENERAL_I
  if destination in PL_BAD-NETS then
    drop
  endif
  if not community matches-any CS_TYPE-ANY then
    drop
  endif
  if not community matches-any CS_RCLASS-ANY then
    drop
  endif
  if as-path in AP_LONG-PATH then
    drop
  endif
  if community matches-any CS_7843-RTBH and destination in (0.0.0.0/0 le 32) then
    set next-hop 192.0.2.0
    pass
  endif
  if community matches-any CS_7843-RTBH and destination in (::/0 le 128) then
    set next-hop 100::
    pass
  endif
  if community matches-any CS_LOCAL-LP-50 then
    set local-preference 50
    pass
  endif
  if community matches-any CS_LOCAL-LP-80 then
    set local-preference 80
    pass
  endif
  if community matches-any CS_LOCAL-LP-120 then
    set local-preference 120
    pass
  endif
  if community matches-any CS_GRACEFUL-SHUTDOWN then
    set local-preference 10
    pass
  endif
  done
end-policy
!
route-policy BP_MARKET-GENERAL_4I
  if destination in PL_BAD-NETS then
    drop
