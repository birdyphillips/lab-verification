  elseif destination in STB-STATIC then
    set community (20115:3105, 20115:60320)
  elseif destination in PROVISIONING-STATIC then
    set community (20115:3100, 20115:60320)
  endif
end-policy
!
route-policy GREEN-TO-AZ
  if destination in AZ-GREEN-OUT then
    # Allow any Public, 172.30, or CMTS space to /AZ/
    pass
  elseif destination in BOGONS then
    # Block all other RFC1918 space
    drop
  endif
end-policy
