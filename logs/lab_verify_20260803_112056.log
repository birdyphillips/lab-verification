class-map match-any QC_APA-HIGH_I
 match dscp 32 38 46 
 match mpls experimental topmost 4 5 
 end-class-map
! 
class-map match-any QC_APA-HIGH_O
 match traffic-class 6 
 end-class-map
! 
class-map match-any QC_APA-MEDIUM_I
 match dscp 8 10 12 16 24 
 match mpls experimental topmost 1 2 3 
 end-class-map
! 
class-map match-any QC_APA-MEDIUM_O
 match traffic-class 3 
 end-class-map
! 
class-map match-any QC_APA-CRITICAL_I
 match dscp 48 56 
 match mpls experimental topmost 6 7 
 end-class-map
! 
class-map match-any QC_APA-CRITICAL_O
 match traffic-class 7 
 end-class-map
! 
policy-map QP_APA_I
 class QC_APA-CRITICAL_I
  set traffic-class 7
 ! 
 class QC_APA-HIGH_I
  set traffic-class 6
 ! 
 class QC_APA-MEDIUM_I
  set traffic-class 3
 ! 
 class class-default
  set traffic-class 0
 ! 
 end-policy-map
! 
policy-map QP_APA_O
 class QC_APA-CRITICAL_O
  priority level 1 
  shape average percent 7 
 ! 
 class QC_APA-HIGH_O
  bandwidth remaining percent 84 
 ! 
 class QC_APA-MEDIUM_O
  bandwidth remaining percent 5 
  random-detect default 
 ! 
 class class-default
  bandwidth remaining percent 1 
  random-detect default 
 ! 
 end-policy-map
